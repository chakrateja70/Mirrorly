# Neon pooled connection string, pasted as-is from the Neon console
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
# A DIFFERENT database (Neon `test` branch): pytest drops and recreates all tables there.
# The test refuses to run if this points at the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST-BRANCH-HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
# At least 32 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Only needed when frontend is served from another origin in production, JSON list
CORS_ORIGINS=[]
# PIN required to change categories and budgets (asked each time that section is opened)
BUDGET_PIN=1234
# Chat assistant on the Home page (https://console.groq.com/keys). Empty = assistant disabled.
# Restart the backend after changing it.
GROQ_API_KEY=
# Optional; must be a Groq model with structured outputs (json_schema)
GROQ_MODEL=openai/gpt-oss-20b
